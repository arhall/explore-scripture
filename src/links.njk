<script>
  document.addEventListener('DOMContentLoaded', () => {
    const types = ['study tools', 'theology', 'video and audio', 'reference', 'history', 'commentary'];
    const categories = [...document.querySelectorAll('.link-category')];
    const search = document.getElementById('resourceSearch');
    const type = document.getElementById('resourceType');
    const count = document.getElementById('resourceCount');
    categories.forEach((category, index) => {
      category.dataset.resourceType = types[index];
      category.querySelectorAll('.study-link').forEach(link => {
        const meta = document.createElement('span');
        meta.className = 'resource-type-label';
        meta.textContent = `${types[index]} • opens ${new URL(link.href).hostname} in a new tab`;
        link.appendChild(meta);
      });
    });
    const filter = () => {
      const term = search.value.trim().toLowerCase();
      let visible = 0;
      categories.forEach(category => {
        let shownInCategory = 0;
        category.querySelectorAll('.study-link').forEach(link => {
          const matches = (!type.value || category.dataset.resourceType === type.value) && link.textContent.toLowerCase().includes(term);
          link.hidden = !matches;
          if (matches) { visible += 1; shownInCategory += 1; }
        });
        category.hidden = shownInCategory === 0;
      });
      count.textContent = `${visible} ${visible === 1 ? 'resource' : 'resources'} shown`;
    };
    search.addEventListener('input', filter);
    type.addEventListener('change', filter);
    filter();
  });
</script>

