---
layout: base.njk
---

<div class="header">
  <h1>{{ category.name }}</h1>
  <span class="badge">{{ category.testament }}</span>
</div>

<div class="chapter-summary">
  <p class="summary-text">{{ category.description }}</p>

  {% if category.themes %}
  <div class="meta">
    <strong>Key Themes:</strong>
    {% for theme in category.themes %}
    <a class="badge" style="margin: 0.2rem" href="/?search={{ theme | urlencode }}">{{ theme }}</a>
    {% endfor %}
  </div>
  {% endif %} {% if category.keyFigures %}
  <div class="meta"><strong>Key Figures:</strong>
    {% for figure in category.keyFigures %}<a href="/entities/?search={{ figure | urlencode }}">{{ figure }}</a>{% if not loop.last %}, {% endif %}{% endfor %}
  </div>
  {% endif %} {% if category.timeSpan %}
  <div class="meta">
    <strong>Time Period:</strong> {{ category.timeSpan }} &nbsp;•&nbsp; <strong>Books:</strong> {{
    category.bookCount }} {% if category.bookCount == 1 %}book{% else %}books{% endif %}
  </div>
  {% endif %}
</div>

<h2>Books in {{ category.name }}</h2>
<div class="grid">
  {% for b in books %} {% if b.category == category.name %}
  <a class="card" href="/books/{{ b.slug }}/">
    <h3>{{ b.name }}</h3>
    <p><strong>Author:</strong> {{ b.author }}</p>
    <p><strong>Language:</strong> {{ b.language }}</p>
    {% if b.chapterSummaries and (b.chapterSummaries | length) > 0 %}
    <p style="font-size: 0.85rem; color: var(--muted)">
      {{ b.chapterSummaries | length }} {% if (b.chapterSummaries | length) == 1 %}chapter{% else %}chapters{% endif %} with summaries
    </p>
    {% endif %}
    <span class="badge">{{ b.testament }}</span>
  </a>
  {% endif %} {% endfor %}
</div>

<p class="back-link">
  <a href="/categories/">← Back to Sections</a>
</p>
