{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard", ":semanticPrefixFixDepsChoreOthers"],
  "timezone": "America/New_York",
  "schedule": ["before 4am on monday"],
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 4am on monday"] },
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "dependencies"],
    "prConcurrentLimit": 5
  },
  "packageRules": [
    {
      "description": "Keep security fixes visible for review",
      "matchUpdateTypes": ["patch", "minor", "pin", "digest", "rollback", "replacement"],
      "automerge": false
    },
    {
      "description": "Group routine development dependency updates",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "development dependencies"
    },
    {
      "description": "Major upgrades require explicit review",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Production dependencies never automerge",
      "matchDepTypes": ["dependencies"],
      "automerge": false
    }
  ]
}
